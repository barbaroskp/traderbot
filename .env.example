# ─────────────────────────────────────────────────────────────────────────────
# BingX Agent — .env template
#
# IMPORTANT: config.py runs with extra="forbid". Any variable in this file that
# does not exactly match a field name in src/config.py will make the bot REFUSE
# TO START. That is deliberate — a silently ignored variable once let the bot
# trade at ~8x the intended size (see POSTMORTEM.md).
#
# You only need the variables below. Everything else falls back to the reviewed
# defaults in src/config.py; override a default only when you know why.
# ─────────────────────────────────────────────────────────────────────────────

# ── BingX API credentials ──
BINGX_API_KEY=your_api_key_here
BINGX_API_SECRET=your_api_secret_here

# ── Mode ──
# Live trading needs BOTH: PAPER_MODE=false AND ALLOW_LIVE_TRADING=true
PAPER_MODE=true
ALLOW_LIVE_TRADING=false

# ── Capital ──
INITIAL_CAPITAL_USDT=50

# ── Position sizing (FRACTIONS OF BALANCE, not USDT amounts) ──
# These replaced the old MAX_TOTAL_MARGIN_USDT / MAX_TRADE_MARGIN_USDT /
# MAX_MARGIN_HIGH_CONVICTION_USDT variables. The old names are no longer
# recognised and will now raise an error instead of being ignored.
# notional = balance * margin_pct * leverage
MAX_TOTAL_MARGIN_PCT=0.30
MAX_TRADE_MARGIN_PCT=0.10
MAX_MARGIN_HIGH_CONVICTION_PCT=0.15
PER_TRADE_FRACTION=0.05

# ── Leverage ──
LEVERAGE=2
MAX_LEVERAGE_ALLOWED=3

# ── Costs — keep these HONEST ──
# BingX taker is ~0.05% = 5bps, and both entry and exit are taker orders.
# Understating these makes every backtest and paper run look better than live.
FEE_RATE_BPS=5.0
SLIPPAGE_ASSUMPTION_BPS=8.0
USE_FUNDING_COST=true

# ── Trade frequency (the dominant cost driver) ──
MAX_OPEN_POSITIONS=2
COOLDOWN_MINUTES=60
SCAN_INTERVAL_MINUTES=5

# ── Signal quality ──
MIN_CLUSTER_CONFLUENCE=4
MIN_WEIGHTED_SCORE_NO_EMA=60

# ── Safety — do not disable these ──
SOFT_KILL_SWITCH_ENABLED=true
SOFT_KILL_DRAWDOWN_PCT=15
RISK_STATE_DISABLED=false

# ── Storage / logging ──
DB_PATH=data/bingx_agent.db
LOG_LEVEL=INFO
LOG_FILE=data/bingx_agent.log

# ── Dashboard: systemd unit name shown as CALISIYOR/DURDU ──
SYSTEMD_SERVICE_NAME=mstis
