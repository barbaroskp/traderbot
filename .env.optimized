# ═══════════════════════════════════════════════════════════════════════
# TRADERBOT .env - Margin-Based Futures Sizing + Exit Mechanic Fixes
# ═══════════════════════════════════════════════════════════════════════
# Temel felsefe:
#   1. Daha az ama daha kaliteli islem (quantity → quality)
#   2. Exit mekanikleri TP/SL oranini korusun (avg win > avg loss)
#   3. Margin-based sizing: kaldirac pozisyonu buyutsun
#   4. Fee erozyonunu minimize et (min TP/SL taban yukseldi)
# ═══════════════════════════════════════════════════════════════════════

# ── BingX API Credentials ──
BINGX_API_KEY=BURAYA_SENIN_API_KEY
BINGX_API_SECRET=BURAYA_SENIN_API_SECRET

# ── Mode ──
PAPER_MODE=false
ALLOW_LIVE_TRADING=true

# ═══════════════════════════════════════════════════════════════════════
# MARGIN-BASED FUTURES SIZING (YENi MODEL)
# ═══════════════════════════════════════════════════════════════════════
# Formul: margin = balance × fraction, notional = margin × leverage
# Ornek: 20 USDT bakiye, %8 fraction → 1.6 USDT margin
#         3x leverage → 4.8 USDT notional pozisyon
# ═══════════════════════════════════════════════════════════════════════
INITIAL_CAPITAL_USDT=20
MAX_TOTAL_MARGIN_USDT=8
MAX_TRADE_MARGIN_USDT=3
PER_TRADE_FRACTION=0.08

# ═══════════════════════════════════════════════════════════════════════
# LEVERAGE & RISK
# ═══════════════════════════════════════════════════════════════════════
# 3x base = dengeli. Sinyal gucune gore 5x/7x'e cikar.
# Eski modelde 2x idi ama pozisyonu buyutmuyordu.
# Yeni modelde 3x → margin 3 katina cikar (gercek futures davranisi).
# ═══════════════════════════════════════════════════════════════════════
LEVERAGE=3
LEVERAGE_HIGH_CONVICTION=7
MAX_LEVERAGE_ALLOWED=10
MARGIN_MODE=ISOLATED

# ── High Conviction (5/5 confluence + %75+ weighted) ──
HIGH_CONVICTION_MIN_CONFLUENCE=5
HIGH_CONVICTION_MIN_WEIGHTED_SCORE=75
HIGH_CONVICTION_MARGIN_MULTIPLIER=1.5
MAX_MARGIN_HIGH_CONVICTION_USDT=5

# ═══════════════════════════════════════════════════════════════════════
# STRATEGY (EMA baseline)
# ═══════════════════════════════════════════════════════════════════════
# TP/SL: 120/50 bps = 2.4:1 oran (fee sonrasi ~1.8:1 hedef)
# Eski 100/50 bps = fee sonrasi 1.15:1 idi → zararin ana sebebi
# ═══════════════════════════════════════════════════════════════════════
FAST_EMA=9
SLOW_EMA=21
ENTRY_THRESHOLD_BPS=30
TP_BPS=120
SL_BPS=50
MAX_HOLD_MINUTES=120
COOLDOWN_MINUTES=8
MAX_OPEN_POSITIONS=4
MAX_Z_SCORE_BPS=180

# ── Multi-Indicator ──
RSI_PERIOD=14
RSI_OVERSOLD=25
RSI_OVERBOUGHT=75
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
MACD_CROSSOVER_BOOST=1.3
MACD_WEAKENING_MULTIPLIER=0.5
BOLLINGER_PERIOD=20
BOLLINGER_STD=2.0
EMA_TREND=50
KLINE_INTERVAL=5m
KLINE_LIMIT=100
HIGHER_TF_INTERVAL=15m
HIGHER_TF_LIMIT=50
USE_HIGHER_TF_TREND=true
REQUIRE_HIGHER_TF_ALIGNMENT=true
ATR_PERIOD=14
ADX_PERIOD=14
ADX_TREND_THRESHOLD=25
ADX_STRONG_THRESHOLD=40
BB_SQUEEZE_THRESHOLD=0.02
BREAKOUT_BB_PCT_HIGH=0.98
BREAKOUT_BB_PCT_LOW=0.02
VOLUME_SPIKE_RATIO=2.0

# ═══════════════════════════════════════════════════════════════════════
# SIGNAL CONFLUENCE - SINYAL KALITESI (KRITIK DEGISIKLIK)
# ═══════════════════════════════════════════════════════════════════════
# Eski: 2 indikator yetiyordu → cok fazla dusuk kaliteli sinyal
# Yeni: 3 indikator + 15m trend onay gerekli → daha az ama daha iyi
# MIN_WEIGHTED_SCORE_NO_EMA: 55 → EMA olmadan daha yuksek esik
# ═══════════════════════════════════════════════════════════════════════
REQUIRE_EMA_IN_CONFLUENCE=true
REQUIRE_EMA_IN_MEAN_REVERSION=true
REQUIRE_EMA_IN_TREND_FOLLOW=false
REQUIRE_EMA_IN_BREAKOUT=false
MIN_CONFLUENCE_SCORE=3
MIN_CONFLUENCE_NO_EMA=4
MIN_WEIGHTED_SCORE_NO_EMA=55
RISK_TIGHT_MIN_WEIGHTED_SCORE=50
RISK_ULTRA_MIN_WEIGHTED_SCORE=65
REQUIRE_TREND_NOT_AGAINST=true
TRADE_WITH_TREND_ONLY=false
RSI_FULL_VOTE_ONLY=false
MIN_VOLUME_RATIO=0.3
USE_REGIME_FILTER=true
USE_BREAKOUT_MODE=true
USE_ORDERBOOK_VOTE=true
ORDERBOOK_IMBALANCE_LONG=0.65
ORDERBOOK_IMBALANCE_SHORT=0.35
USE_FUNDING_FILTER=true
FUNDING_RATE_THRESHOLD=0.0005
FUNDING_CONTRA_BONUS=5.0

# ── Indicator Weights ──
WEIGHT_EMA=25
WEIGHT_RSI=25
WEIGHT_MACD=20
WEIGHT_BOLLINGER=15
WEIGHT_TREND=15
WEIGHT_ORDERBOOK=10
WEIGHT_BREAKOUT=20
WEIGHT_VOLUME_SPIKE=5
WEIGHT_VWAP=10
WEIGHT_MOMENTUM=10
WEIGHT_STOCH_RSI=15
WEIGHT_ADX=10
STOCH_RSI_OVERSOLD=20
STOCH_RSI_OVERBOUGHT=80
HIGHER_TF_ALIGNMENT_BONUS=10

# ── New Indicators (Tier 1+2) ──
WEIGHT_TAKER_RATIO=15
TAKER_BUY_RATIO_LONG=0.58
TAKER_BUY_RATIO_SHORT=0.42
TAKER_RATIO_PERIOD=20
WEIGHT_OBV=10
WEIGHT_WILLIAMS_R=10
WILLIAMS_R_PERIOD=14
WILLIAMS_R_OVERSOLD=-80
WILLIAMS_R_OVERBOUGHT=-20
WEIGHT_SQUEEZE=15
KELTNER_PERIOD=20
KELTNER_ATR_MULT=1.5
USE_OPEN_INTEREST=true
WEIGHT_OI=15
OI_CHANGE_THRESHOLD_PCT=3.0
WEIGHT_VELOCITY=5
VELOCITY_LOOKBACK=5
VELOCITY_THRESHOLD_BPS=30
WEIGHT_WHALE=12
WHALE_IMBALANCE_THRESHOLD=0.65
WEIGHT_LIQ_CASCADE=15
LIQ_CASCADE_MIN_INTENSITY=0.3
WEIGHT_VOLUME_PROFILE=10
USE_SENTIMENT=true
WEIGHT_SENTIMENT=10
SENTIMENT_THRESHOLD=20

# ── Momentum Quality Filter ──
REQUIRE_MOMENTUM_CONFIRMATION=true
MOMENTUM_BONUS_WEIGHT=10
NO_MOMENTUM_DISCOUNT=0.7

# ── Session/Funding Time Awareness ──
AVOID_FUNDING_WINDOW=true
FUNDING_WINDOW_MINUTES=15

# ── Correlation Filter ──
USE_CORRELATION_FILTER=true
MAX_SAME_DIRECTION_POSITIONS=3

# ═══════════════════════════════════════════════════════════════════════
# EXIT MECHANICS - KARIN ERIDIGI YER (EN KRITIK DUZELTMELER)
# ═══════════════════════════════════════════════════════════════════════
# SORUN: Eskiden avg win (0.0489) < avg loss (0.0567)
# SEBEP: Partial TP %50'de, trailing %40'ta aktif, momentum early exit
#
# DUZELTMELER:
# 1. Momentum exit KAPALI → zarar pozisyonlari erken kapatmayi birak
#    (SL zaten var, birak SL isini yapsin)
# 2. Partial TP tetikleme %50 → %75 (hedefe yaklasinca al, cok erken degil)
# 3. Trailing stop %40 → %70 (kar olgunlassin, sonra trail etsin)
# 4. Min TP 60 → 100 bps (fee sonrasi bile anlamli kar kalsin)
# 5. Min SL 30 → 40 bps (cok dar SL = noise'dan stop olur)
# 6. Time decay daha gec baslasin (%60, %40 degil)
# ═══════════════════════════════════════════════════════════════════════
USE_MOMENTUM_EXIT=false
USE_TIME_DECAY_SL=true
TIME_DECAY_START_PCT=0.6
TIME_DECAY_SL_REDUCTION_PCT=0.4

# ── Kelly Criterion Sizing ──
USE_KELLY_SIZING=true
KELLY_FRACTION=0.5
KELLY_MIN_TRADES=20
KELLY_MIN_FRACTION=0.02
KELLY_MAX_FRACTION=0.12

# ── Volatility-Adjusted Sizing ──
USE_VOLATILITY_SIZING=true
TARGET_RISK_PCT=0.02
VOLATILITY_SIZING_ATR_MULT=1.2

# ── Selector ──
MAX_SPREAD_BPS=40
MIN_DEPTH_USDT=500
VOL_GUARD_BPS=800
SHORTLIST_SIZE=700

# ═══════════════════════════════════════════════════════════════════════
# TRADE MANAGEMENT - TP/SL MEKANIKLERI
# ═══════════════════════════════════════════════════════════════════════
USE_DYNAMIC_TP_SL=true
ATR_SL_MULTIPLIER=1.0
ATR_TP_MULTIPLIER=2.5
MIN_SL_BPS=40
MIN_TP_BPS=100
USE_TRAILING_STOP=true
TRAILING_ACTIVATION_PCT=0.7
TRAILING_DISTANCE_PCT=0.5
USE_BREAKEVEN_STOP=true
BREAKEVEN_ACTIVATION_PCT=0.4
BREAKEVEN_BUFFER_BPS=3.0
USE_PARTIAL_TP=true
PARTIAL_TP_FRACTION=0.5
PARTIAL_TP_TRIGGER_PCT=0.75

# ═══════════════════════════════════════════════════════════════════════
# DYNAMIC LEVERAGE (sinyal gucune gore otomatik)
# ═══════════════════════════════════════════════════════════════════════
# Tier 1 (3+ confluence, %50+ score): 5x
# Tier 2 (4+ confluence, %65+ score): 7x
# Tier 3 (5  confluence, %80+ score): 10x
# ═══════════════════════════════════════════════════════════════════════
DYNAMIC_LEVERAGE_ENABLED=true
DYN_LEVERAGE_TIER1_CONFLUENCE=3
DYN_LEVERAGE_TIER1_WEIGHTED_SCORE=50
DYN_LEVERAGE_TIER1=5
DYN_LEVERAGE_TIER2_CONFLUENCE=4
DYN_LEVERAGE_TIER2_WEIGHTED_SCORE=65
DYN_LEVERAGE_TIER2=7
DYN_LEVERAGE_TIER3_CONFLUENCE=5
DYN_LEVERAGE_TIER3_WEIGHTED_SCORE=80
DYN_LEVERAGE_TIER3=10

# ── Anti-Liquidation ──
ANTI_LIQUIDATION_ENABLED=true
LIQUIDATION_SAFETY_MARGIN_PCT=25
MAX_LEVERAGE_FOR_PRICE=true

# ── Risk State Thresholds ──
RISK_CONSEC_LOSSES_TIGHT=6
RISK_DRAWDOWN_PCT_TIGHT=8.0
RISK_DRAWDOWN_MIN_FOR_CONSEC_TIGHT=2.0
RISK_API_ERROR_RATE_TIGHT=0.3
RISK_CONSEC_LOSSES_ULTRA=12
RISK_DRAWDOWN_PCT_ULTRA=18.0
RISK_DRAWDOWN_MIN_FOR_CONSEC_ULTRA=5.0
RISK_API_ERROR_RATE_ULTRA=0.5
RISK_CONSEC_WINS_RECOVER=2
RISK_STABLE_CYCLES_RECOVER=3
RISK_MAX_MINUTES_IN_TIGHT=20
RISK_MAX_MINUTES_IN_ULTRA=45

# ═══════════════════════════════════════════════════════════════════════
# SWING TRADING (1h mumlar, daha genis TP/SL)
# ═══════════════════════════════════════════════════════════════════════
SWING_ENABLED=true
SWING_INTERVAL=1h
SWING_KLINE_LIMIT=100
SWING_TREND_INTERVAL=4h
SWING_TREND_LIMIT=50
SWING_SCAN_EVERY_N_CYCLES=5
SWING_TP_BPS=300
SWING_SL_BPS=150
SWING_MAX_HOLD_MINUTES=1440
SWING_MAX_POSITIONS=2
SWING_MIN_CONFLUENCE=3
SWING_REQUIRE_TREND_ALIGNMENT=true
SWING_ATR_SL_MULTIPLIER=1.5
SWING_ATR_TP_MULTIPLIER=3.0
SWING_COOLDOWN_MINUTES=30
SWING_LEVERAGE=2

# ── Scheduling ──
SCAN_INTERVAL_MINUTES=3
SCAN_INTERVAL_ACTIVE_MINUTES=1
USE_ADAPTIVE_SCAN=true
UNIVERSE_REFRESH_HOURS=6

# ── Runtime Safety & Maintenance ──
LIVE_SLIPPAGE_GUARD_BPS=30
SOFT_KILL_SWITCH_ENABLED=true
SOFT_KILL_API_ERROR_RATE=0.85
SOFT_KILL_DRAWDOWN_PCT=30
SOFT_KILL_MIN_BALANCE_RATIO=0.15
SOFT_KILL_COOLDOWN_CYCLES=2
RECONCILE_INTERVAL_CYCLES=5
SELECTOR_LENIENT_ENABLED=true
SELECTOR_LENIENT_SPREAD_MULT=1.25
SELECTOR_LENIENT_DEPTH_MULT=0.75
SELECTOR_LENIENT_MIN_TRADEABLE=8
DB_MAINTENANCE_INTERVAL_CYCLES=60
DB_VACUUM_INTERVAL_CYCLES=240
DB_RETENTION_DAYS=21

# ── Dashboard ──
SYSTEMD_SERVICE_NAME=mstis

# ── Database ──
DB_PATH=data/bingx_agent.db

# ── Logging ──
LOG_LEVEL=INFO
LOG_FILE=data/bingx_agent.log

# ── Fees ──
FEE_RATE_BPS=4.0

# ── Paper Mode Simulation ──
SLIPPAGE_ASSUMPTION_BPS=3

# ── LLM Advisor ──
# Su an kapatik. Oncelik exit mekaniklarini duzeltmek.
# Ileri asamada Ollama 8B+ model ile sinyal filtreleme denenebilir.
USE_LLM_ADVISOR=false
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=8
OLLAMA_MAX_CALLS_PER_CYCLE=3
