# ─────────────────────────────────────────────────────────────────────────────
# CONSERVATIVE PROFILE (replaces the previous ".optimized" profile)
#
# WHAT WAS WRONG WITH THE OLD VERSION OF THIS FILE — see POSTMORTEM.md:
#
#   1. It set MAX_TOTAL_MARGIN_USDT=8 / MAX_TRADE_MARGIN_USDT=3 /
#      MAX_MARGIN_HIGH_CONVICTION_USDT=5. Commit 00ee744 had already renamed
#      those fields to *_PCT, and config.py ran with extra="ignore", so all
#      three were silently discarded and the percentage defaults applied
#      (80% / 20% / 30% of balance). The intended "8 USDT max exposure" was
#      actually up to ~8x balance in notional at 10x leverage.
#   2. FEE_RATE_BPS=4.0 understated the real BingX taker cost (5bps per side,
#      both sides taker) and SLIPPAGE_ASSUMPTION_BPS=3 understated real market
#      order slippage. Funding was not modelled at all.
#   3. It was tuned for TRADE COUNT, not expectancy: scan every 1-3 minutes,
#      4 concurrent positions, 8 minute cooldown, 700-symbol shortlist,
#      40bps spread cap, and up to 10x dynamic leverage. At ~20bps real
#      friction per round trip that burns 9-22% of balance per DAY before the
#      strategy has any chance to add value.
#   4. Every safety mechanism was off: RISK_STATE_DISABLED=true,
#      SOFT_KILL_SWITCH_ENABLED=false, drawdown limit 30% and never reached.
#
# The values below invert those choices. They are intentionally restrictive:
# the point is to lose slowly enough that a real edge, if one exists, becomes
# measurable. Do not loosen them to "get more trades" — that is exactly the
# mistake that produced the -84% run.
# ─────────────────────────────────────────────────────────────────────────────

PAPER_MODE=true
ALLOW_LIVE_TRADING=false
INITIAL_CAPITAL_USDT=50

# ── Position sizing: fractions of balance ──
MAX_TOTAL_MARGIN_PCT=0.30
MAX_TRADE_MARGIN_PCT=0.10
MAX_MARGIN_HIGH_CONVICTION_PCT=0.15
PER_TRADE_FRACTION=0.05

# ── Leverage: fixed and low; dynamic leverage stays off ──
LEVERAGE=2
LEVERAGE_HIGH_CONVICTION=3
MAX_LEVERAGE_ALLOWED=3
DYNAMIC_LEVERAGE_ENABLED=false
MARGIN_MODE=ISOLATED

# ── Honest cost model ──
FEE_RATE_BPS=5.0
SLIPPAGE_ASSUMPTION_BPS=8.0
USE_FUNDING_COST=true
LIVE_SLIPPAGE_GUARD_BPS=10

# ── Frequency: the single biggest lever on cost ──
MAX_OPEN_POSITIONS=2
COOLDOWN_MINUTES=60
SCAN_INTERVAL_MINUTES=5
SCAN_INTERVAL_ACTIVE_MINUTES=5
MAX_HOLD_MINUTES=180

# ── Universe: small and liquid. Spread IS slippage. ──
SHORTLIST_SIZE=25
MIN_VOLUME_24H_USDT=50000000
MAX_SPREAD_BPS=8
MIN_DEPTH_USDT=25000
SELECTOR_LENIENT_ENABLED=false

# ── Signal quality: require real agreement ──
ENTRY_THRESHOLD_BPS=30
MIN_CLUSTER_CONFLUENCE=4
MIN_WEIGHTED_SCORE_NO_EMA=60
RSI_FULL_VOTE_ONLY=true
MIN_VOLUME_RATIO=0.5
USE_REGIME_FILTER=true
REQUIRE_TREND_NOT_AGAINST=true

# ── Exits: TP must clear full round-trip cost ──
MIN_SL_BPS=50
MIN_TP_BPS=100
MIN_TP_NET_BPS=40

# ── Sizing: Kelly may go to zero when the edge is negative ──
USE_KELLY_SIZING=true
KELLY_FRACTION=0.25
KELLY_MIN_TRADES=30
KELLY_MIN_FRACTION=0.0
KELLY_MAX_FRACTION=0.10
KELLY_BLOCK_ON_NEGATIVE_EDGE=true

# ── Safety: these must stay on ──
RISK_STATE_DISABLED=false
SOFT_KILL_SWITCH_ENABLED=true
SOFT_KILL_DRAWDOWN_PCT=15
SOFT_KILL_MIN_BALANCE_RATIO=0.70
SOFT_KILL_COOLDOWN_CYCLES=20
ANTI_LIQUIDATION_ENABLED=true

# ── Swing (1h) ──
SWING_ENABLED=true
SWING_MAX_POSITIONS=1
SWING_MIN_CONFLUENCE=4
SWING_LEVERAGE=2
SWING_COOLDOWN_MINUTES=120

DB_PATH=data/bingx_agent.db
LOG_LEVEL=INFO
LOG_FILE=data/bingx_agent.log
